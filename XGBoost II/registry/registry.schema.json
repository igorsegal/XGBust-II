{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "XGBoost-edge rules registry",
 "type": "object",
 "required": [
  "registry_version",
  "defaults",
  "rules"
 ],
 "properties": {
  "registry_version": {
   "type": "integer"
  },
  "defaults": {
   "type": "object",
   "required": [
    "exits",
    "costs",
    "split",
    "criteria"
   ]
  },
  "rules": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "name",
     "source",
     "status",
     "enabled_by_default",
     "direction",
     "timeframes",
     "pairs",
     "params",
     "implementation",
     "audit",
     "results"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[A-Z0-9_]+$"
     },
     "status": {
      "enum": [
       "spec_ready",
       "implemented_untested",
       "tested_pass",
       "tested_fail",
       "dev_pass",
       "prototype_unconfirmed",
       "rejected",
       "example"
      ]
     },
     "enabled_by_default": {
      "type": "boolean"
     },
     "direction": {
      "enum": [
       "long",
       "short",
       "both"
      ]
     },
     "timeframes": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "pairs": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "params": {
      "type": "object",
      "additionalProperties": {
       "type": "object",
       "required": [
        "type",
        "default",
        "min",
        "max"
       ],
       "properties": {
        "type": {
         "enum": [
          "int",
          "float",
          "bool"
         ]
        }
       }
      }
     },
     "implementation": {
      "type": [
       "object",
       "null"
      ],
      "properties": {
       "kind": {
        "enum": [
         "cpp",
         "expr",
         "strategy", "signals"
        ]
       }
      }
     },
     "results": {
      "type": "array"
     },
     "inputs": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "name",
        "indicator"
       ],
       "properties": {
        "name": {
         "type": "string",
         "pattern": "^[a-z][a-z0-9_]*$"
        },
        "indicator": {
         "type": "string"
        },
        "output": {
         "type": "string"
        },
        "tf": {
         "type": "string"
        },
        "source": {
         "type": "string"
        },
        "params": {
         "type": "object"
        }
       }
      }
     },
     "entry_long_expr": {
      "type": "string"
     },
     "entry_short_expr": {
      "type": "string"
     }
    }
   }
  }
 }
}